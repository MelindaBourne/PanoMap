# PanoMap Environment Variables

# Amap (高德地图) API key - Get yours at https://lbs.amap.com/
AMAP_API_KEY=your_amap_api_key_here

# JWT secret key (change this to a strong random string in production)
JWT_SECRET=change-this-to-a-strong-random-secret

# Server port (default: 3000)
PORT=3000

# Default map center: longitude,latitude (default: Beijing)
MAP_DEFAULT_CENTER=116.397428,39.90923

# Default map zoom level (default: 11)
MAP_DEFAULT_ZOOM=11
